{
  "name": "dsh-univer-office",
  "version": "0.1.1",
  "private": true,
  "description": "从零实现的浏览器 PPTX 内核：打开演示文稿、编辑文字、新增幻灯片，并覆盖保存当前文件。",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "pptx:web": "esbuild packages/pptx-kernel/web/main.ts --bundle --outfile=packages/pptx-kernel/web/editor.js --format=esm --platform=browser",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p packages/pptx-kernel/tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@amamo/oxlint-config": "1.1.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0"
}
